# Qmagic Framework Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit real credentials to version control

# Application URLs
BASE_URL=https://opensource-demo.orangehrmlive.com
API_BASE_URL=https://opensource-demo.orangehrmlive.com

# Authentication
API_AUTH_TOKEN=your-auth-token-here

# Test Environment
ENVIRONMENT=local
BROWSER=chromium

# User Credentials (examples - replace with your test users)
# WARNING: Never commit real credentials
# Usernames live in data/user.json (test data, not secrets); each key there needs a
# matching <KEY>_PASSWORD env var (camelCase key -> SCREAMING_SNAKE_CASE + _PASSWORD).
USER_PASSWORD=admin123
SECOND_USER_PASSWORD=secondpassword123
ADMIN_PASSWORD=adminpassword123

# CI/CD Configuration (optional)
CI=false
ALLURE=false